# Copie este arquivo para `.env.local` e preencha apenas o que for usar.
# As variáveis são lidas no momento do build (`npm run build`).

# Endereço público do site (usado em canonical, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.marcobispo.com

# Medição: desligada por padrão. Preencher qualquer uma das duas ativa
# o aviso de cookies; os scripts só carregam depois do consentimento.
# Google Analytics 4 (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel (apenas números)
NEXT_PUBLIC_META_PIXEL_ID=
